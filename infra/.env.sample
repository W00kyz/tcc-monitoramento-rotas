# Lista autoritativa de variáveis de ambiente. Copiar para infra/.env e preencher.
# NUNCA commitar o .env — o .gitignore já o bloqueia.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=route_monitor
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=route_monitor
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://route_monitor:change_me_in_local_env@postgres:5432/route_monitor

# --- Dashboard ---
DASHBOARD_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- MinIO ---
MINIO_ROOT_USER=route_monitor
MINIO_ROOT_PASSWORD=change_me_in_local_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
