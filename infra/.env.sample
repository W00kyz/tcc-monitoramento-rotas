# Lista autoritativa de variáveis de ambiente. Copiar para infra/.env e preencher.
# NUNCA commitar o .env — o .gitignore já o bloqueia.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=route_monitor
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=route_monitor
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://route_monitor:change_me_in_local_env@postgres:5432/route_monitor

# --- Dashboard ---
DASHBOARD_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- MinIO ---
MINIO_ROOT_USER=route_monitor
MINIO_ROOT_PASSWORD=change_me_in_local_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Backend: autenticação ---
JWT_SECRET_KEY=change_me_in_local_env
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- Backend: e-mail (Mailpit, endereço interno do compose) ---
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@pu.ufcg.edu.br
DASHBOARD_BASE_URL=http://localhost:5173

# --- Backend: assinatura de QR Code (Ed25519, gerada na Task 7) ---
QR_SIGNING_PRIVATE_KEY_HEX=change_me_generate_with_scripts

# --- OSRM ---
OSRM_BASE_URL=http://osrm:5000
