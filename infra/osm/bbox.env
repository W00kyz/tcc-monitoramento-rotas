# Recorte do Campus I da UFCG, Campina Grande. Ordem: oeste,sul,leste,norte.
# Refinar contra o polígono real do campus no levantamento da Etapa 3 — este é
# um retângulo generoso, deliberadamente maior que o campus.
CAMPUS_BBOX="-35.9200,-7.2250,-35.8980,-7.2050"

# Extrato de origem. A Geofabrik não publica extrato por município, então o
# recorte é feito localmente a partir do Nordeste.
OSM_SOURCE_URL="https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf"
OSM_SOURCE_FILE="nordeste-latest.osm.pbf"
