# Recorte do banco de testes manual: Rua Raimundo da Silva Ribeiro, Tambor,
# Campina Grande. Ordem: oeste,sul,leste,norte (igual a bbox.env).
#
# Base: bbox de backend/app/seed_data/tambor_buildings.json (extensão das
# edificações + 150 m): sul -7.2608771, oeste -35.8899253, norte -7.2540855,
# leste -35.8849549. O retângulo do campus de teste é essa bbox + 500 m; este
# recorte a amplia em 1,5 km por lado, para o mapa e o OSRM cobrirem o campus de
# teste com folga (~1 km além dele) e o ponto de rua (-7.2567, -35.8900).
#
# Aritmética (lat ≈ -7,26°; 1° de latitude ≈ 111320 m):
#   1500 m em latitude  = 1500 / 111320                = 0,013475°
#   1500 m em longitude = 1500 / (111320 * cos 7,26°)  = 0,013584°
#   oeste = -35.8899253 - 0,013584 = -35.9035
#   sul   =  -7.2608771 - 0,013475 =  -7.2744
#   leste = -35.8849549 + 0,013584 = -35.8714
#   norte =  -7.2540855 + 0,013475 =  -7.2406
TEST_BBOX="-35.9035,-7.2744,-35.8714,-7.2406"
